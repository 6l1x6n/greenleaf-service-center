{
  // Cloudflare Worker: сайт Greenleaf (статик-ассеты из public/)
  // + обработка форм → Telegram в worker.js
  // TG_BOT_TOKEN и TG_CHAT_ID — секреты Worker: npx wrangler secret put <ИМЯ>
  "name": "mygreenleaf",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "kv_namespaces": [
    {
      "binding": "SC_STORES",
      "id": "24ef0b12e7a74c618643d21b52edceec"
    }
  ],
  // ИИ-менеджер: инференс Llama 3.1 8B fp8-fast через биндинг AI
  // (10 000 нейронов/сутки бесплатно; без биндинга сайт отвечает шаблонами).
  // Если деплой ругнётся — создать биндинг в дашборде: Workers → mygreenleaf →
  // Settings → Bindings → Add → Workers AI → имя AI.
  "ai": {
    "binding": "AI"
  },
  // Workers Cache: ответы воркера кешируются на edge по Cache-Control
  // (повторные запросы ботов/краулеров НЕ запускают воркер)
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false
  }
}
